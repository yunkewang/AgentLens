{
  "name": "agentlens",
  "version": "0.1.0",
  "description": "See how AI agents see your repo. Local-first CLI and static report generator for agent instruction files.",
  "main": "dist/cli.js",
  "bin": {
    "agentlens": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli.ts",
    "test": "jest --testPathPattern=tests/",
    "lint": "tsc --noEmit"
  },
  "keywords": ["agents", "ai", "cli", "developer-tools", "mcp", "cursor"],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "express": "^4.19.2",
    "fast-glob": "^3.3.2",
    "fs-extra": "^11.2.0",
    "gray-matter": "^4.0.3",
    "marked": "^12.0.0",
    "open": "^10.1.0",
    "simple-git": "^3.25.0",
    "tmp-promise": "^3.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/tests"]
  }
}
